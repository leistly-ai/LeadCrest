# LeadCrest Environment Variables
# Copy this file to .env and fill in your actual values

# ========== Twilio Configuration (NEW - Required for calling feature) ==========
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+14165551234

# ========== Application URL ==========
# For local development with ngrok: https://abc123.ngrok.io
# For production: https://your-domain.com
APP_URL=http://localhost:5000

# ========== Google AI (Already Configured) ==========
GEMINI_API_KEY=your_gemini_api_key_here
REAL_GEMINI_KEY=your_gemini_api_key_here

# ========== Email Service (Already Configured) ==========
RESEND_API_KEY=your_resend_api_key_here

# ========== Firebase Configuration (Already Configured) ==========
# These should match your firebase-applet-config.json
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ========== Server Configuration ==========
PORT=5000
NODE_ENV=development
